# Copy this file to `.env` for local runs. NEVER commit `.env` itself.

# TransLink developer API key (https://developer.translink.ca)
TRANSLINK_API_KEY=your_translink_key_here

# Supabase project credentials
# SUPABASE_URL looks like: https://abcdefghijklmno.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_BUCKET_NAME=translink-raw
